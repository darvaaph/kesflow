# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Mode Mock / Demo Lokal (Aktifkan jika belum memiliki Supabase)
NEXT_PUBLIC_ENABLE_MOCK_MODE=true

# Server-only: dibutuhkan untuk mengirim push ke pasangan, jangan gunakan NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: VAPID Keys untuk Web Push Notification (iOS 16.4+ PWA & Android)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kesflow.app

# Optional: Google Gemini API Key untuk fitur Scan Struk Kasir Otomatis (AI OCR)
GEMINI_API_KEY=your-gemini-api-key-here
